rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLockId(id) {
      return id is string && id.size() > 0 && id.size() <= 160 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return isSignedIn()
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') in ['muhammadhaikalmalilang@gmail.com'];
    }

    function isUserDocActiveWithRoles(data, roles) {
      return 'isActive' in data
        && 'role' in data
        && data.isActive == true
        && data.role in roles;
    }

    function isActiveWithRoles(roles) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && isUserDocActiveWithRoles(get(/databases/$(database)/documents/users/$(request.auth.uid)).data, roles);
    }

    function isActiveStaff() {
      return isBootstrapAdmin() || isActiveWithRoles(['Administrator', 'Managerial', 'Kepala Ruang', 'PJ Shift', 'Perawat Pelaksana']);
    }

    function isAdmin() {
      return isBootstrapAdmin() || isActiveWithRoles(['Administrator']);
    }

    function isVerifier() {
      return isBootstrapAdmin() || isActiveWithRoles(['Administrator', 'Kepala Ruang', 'PJ Shift']);
    }

    function isLeadershipOrAdmin() {
      return isBootstrapAdmin() || isActiveWithRoles(['Administrator', 'Managerial', 'Kepala Ruang', 'PJ Shift']);
    }

    function isPjShiftUser() {
      return isActiveWithRoles(['PJ Shift']);
    }

    function isKepalaRuangUser() {
      return isActiveWithRoles(['Kepala Ruang']);
    }

    function isScheduleShift(schedData, targetShift) {
      return 'shift' in schedData && schedData.shift == targetShift;
    }

    function hasScheduleOnSlot(uid, targetDate, targetShift) {
      return targetDate is string && targetDate.size() == 10
        && exists(/databases/$(database)/documents/schedules/$(uid + '_' + targetDate))
        && isScheduleShift(get(/databases/$(database)/documents/schedules/$(uid + '_' + targetDate)).data, targetShift);
    }

    function isAssignedPjOnDoc(assignData, uid) {
      return 'pjNurseId' in assignData && assignData.pjNurseId == uid;
    }

    function hasAuthorizedPjOnSlot(uid, targetDate, targetShift) {
      return targetDate is string && targetDate.size() == 10
        && (
          exists(/databases/$(database)/documents/pj_shift_assignments/$(targetDate + '_' + targetShift))
            ? isAssignedPjOnDoc(get(/databases/$(database)/documents/pj_shift_assignments/$(targetDate + '_' + targetShift)).data, uid)
            : hasScheduleOnSlot(uid, targetDate, targetShift)
        );
    }

    function isNextShiftHandoverMatch(currentShift, currentDate, nextShift, nextDate) {
      return (currentShift == 'Pagi' && nextShift == 'Siang' && nextDate == currentDate)
        || (currentShift == 'Siang' && nextShift == 'Malam' && nextDate == currentDate)
        || (currentShift == 'Malam' && nextShift == 'Pagi' && nextDate is string && nextDate.matches('^\\d{4}-\\d{2}-\\d{2}$') && nextDate > currentDate);
    }

    function isLogbookPendingForNurse(logData, lockNurseId) {
      return 'verificationStatus' in logData
        && 'nurseId' in logData
        && logData.verificationStatus in ['Pending', 'Revision']
        && logData.nurseId == lockNurseId;
    }

    function isVerifierEditingPendingLogbook(logId, lockNurseId) {
      return isVerifier()
        && isValidId(logId)
        && exists(/databases/$(database)/documents/logbook/$(logId))
        && isLogbookPendingForNurse(get(/databases/$(database)/documents/logbook/$(logId)).data, lockNurseId);
    }

    function isValidRole(role) {
      return role in ['Administrator', 'Managerial', 'Kepala Ruang', 'PJ Shift', 'Perawat Pelaksana'];
    }

    // 3. Entity Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'fullName', 'nip', 'role', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'fullName', 'nip', 'role', 'isActive', 'phone', 'specialization', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.nip is string && data.nip.size() >= 1 && data.nip.size() <= 40
        && isValidRole(data.role)
        && data.isActive is bool
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('specialization' in data) || (data.specialization is string && data.specialization.size() <= 100))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStaffDirectory(data) {
      return data.keys().hasAll(['uid', 'fullName', 'role', 'isActive', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'fullName', 'role', 'isActive', 'updatedAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && isValidRole(data.role)
        && data.isActive is bool
        && data.updatedAt is timestamp;
    }

    function isValidWizardDetails(wd) {
      return wd is map
        && wd.keys().hasOnly(['section1', 'section2', 'section3', 'section4', 'section5', 'section6', 'section7', 'spoChecklist', 'customResponses'])
        && (!('section7' in wd) || wd.section7 is map)
        && (!('spoChecklist' in wd) || (wd.spoChecklist is map && wd.spoChecklist.size() <= 120))
        && (!('customResponses' in wd) || (wd.customResponses is map && wd.customResponses.size() <= 120));
    }

    function isValidLogbookEntryFields(data) {
      return data.keys().hasAll([
          'nurseId', 'nurseName', 'nurseNip', 'patientId', 'patientName', 'patientRm',
          'machineId', 'machineNumber', 'doctorId', 'doctorName', 'actionCategory',
          'date', 'monthKey', 'shift', 'startTime', 'endTime',
          'preWeight', 'postWeight', 'preBp', 'postBp', 'ufGoal', 'ufAchieved',
          'vascularAccess', 'heparinType', 'complications', 'nursingNotes',
          'verificationStatus', 'createdAt', 'updatedAt'
        ])
        && data.nurseId is string && data.nurseId.size() > 0 && data.nurseId.size() <= 128
        && data.nurseName is string && data.nurseName.size() >= 1 && data.nurseName.size() <= 120
        && data.nurseNip is string && data.nurseNip.size() <= 40
        && data.patientId is string && data.patientId.size() > 0 && data.patientId.size() <= 128
        && data.patientName is string && data.patientName.size() >= 1 && data.patientName.size() <= 120
        && data.patientRm is string && data.patientRm.size() <= 40
        && data.machineId is string && data.machineId.size() > 0 && data.machineId.size() <= 128
        && data.machineNumber is string && data.machineNumber.size() >= 1 && data.machineNumber.size() <= 40
        && data.doctorId is string && data.doctorId.size() > 0 && data.doctorId.size() <= 128
        && data.doctorName is string && data.doctorName.size() >= 1 && data.doctorName.size() <= 120
        && (!('dutyDoctorId' in data) || data.dutyDoctorId == null || (data.dutyDoctorId is string && data.dutyDoctorId.size() <= 128))
        && (!('dutyDoctorName' in data) || data.dutyDoctorName == null || (data.dutyDoctorName is string && data.dutyDoctorName.size() <= 120))
        && data.actionCategory is string && data.actionCategory.size() >= 1 && data.actionCategory.size() <= 80
        && data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.monthKey is string && data.monthKey.matches('^\\d{4}-\\d{2}$')
        && data.shift in ['Pagi', 'Siang', 'Malam']
        && data.startTime is string && data.startTime.size() <= 10
        && data.endTime is string && data.endTime.size() <= 10
        && data.preWeight is number && data.preWeight >= 0 && data.preWeight <= 300
        && data.postWeight is number && data.postWeight >= 0 && data.postWeight <= 300
        && data.preBp is string && data.preBp.size() <= 20
        && data.postBp is string && data.postBp.size() <= 20
        && data.ufGoal is number && data.ufGoal >= 0 && data.ufGoal <= 10000
        && data.ufAchieved is number && data.ufAchieved >= 0 && data.ufAchieved <= 10000
        && data.vascularAccess in ['AV Shunt', 'AV Fistula', 'CDL', 'Femoral', 'AVG', 'CVC']
        && data.heparinType in ['Standar', 'Minimal', 'Bebas Heparin', 'Heparin', 'LMWH']
        && data.complications is string && data.complications.size() <= 300
        && data.nursingNotes is string && data.nursingNotes.size() <= 1000
        && data.verificationStatus in ['Draft', 'Pending', 'Approved', 'Revision']
        && (!('targetVerifierRole' in data) || data.targetVerifierRole == null || data.targetVerifierRole in ['PJ Shift', 'Kepala Ruang'])
        && (!('targetVerifierId' in data) || data.targetVerifierId == null || (data.targetVerifierId is string && data.targetVerifierId.size() <= 128))
        && (!('targetVerifierName' in data) || data.targetVerifierName == null || (data.targetVerifierName is string && data.targetVerifierName.size() <= 120))
        && (!('verifiedBy' in data) || data.verifiedBy == null || (data.verifiedBy is string && data.verifiedBy.size() <= 128))
        && (!('verifiedByName' in data) || data.verifiedByName == null || (data.verifiedByName is string && data.verifiedByName.size() <= 120))
        && (!('verificationNote' in data) || data.verificationNote == null || (data.verificationNote is string && data.verificationNote.size() <= 500))
        && (!('verifiedAt' in data) || data.verifiedAt == null || data.verifiedAt is timestamp)
        && (!('wizardDetails' in data) || data.wizardDetails == null || isValidWizardDetails(data.wizardDetails))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLogbookEntry(data) {
      return isValidLogbookEntryFields(data)
        && data.keys().hasOnly([
          'nurseId', 'nurseName', 'nurseNip', 'patientId', 'patientName', 'patientRm',
          'machineId', 'machineNumber', 'doctorId', 'doctorName', 'actionCategory',
          'date', 'monthKey', 'shift', 'startTime', 'endTime',
          'preWeight', 'postWeight', 'preBp', 'postBp', 'ufGoal', 'ufAchieved',
          'vascularAccess', 'heparinType', 'complications', 'nursingNotes',
          'verificationStatus', 'targetVerifierRole', 'targetVerifierId', 'targetVerifierName',
          'verifiedBy', 'verifiedByName', 'verificationNote', 'verifiedAt',
          'dutyDoctorId', 'dutyDoctorName', 'wizardDetails', 'createdAt', 'updatedAt'
        ]);
    }

    function isValidLogbookVerification(data) {
      return 'verifiedByName' in data
        && data.verifiedByName is string && data.verifiedByName.size() > 0 && data.verifiedByName.size() <= 120
        && (!('verificationNote' in data) || data.verificationNote == null || (data.verificationNote is string && data.verificationNote.size() <= 500));
    }

    function canUpdateLogbook(logbookId, data, prev) {
      return isValidId(logbookId)
        && data.updatedAt == request.time
        && (!('nurseId' in prev) || data.nurseId == prev.nurseId)
        && (
          ('nurseName' in prev && prev.nurseName is string && prev.nurseName.trim().size() > 0 && prev.nurseName.size() <= 120 && data.nurseName == prev.nurseName) ||
          (!('nurseName' in prev) || !(prev.nurseName is string) || prev.nurseName.trim().size() == 0 || prev.nurseName.size() > 120)
        )
        && (
          ('createdAt' in prev && prev.createdAt is timestamp && data.createdAt == prev.createdAt) ||
          ((!('createdAt' in prev) || !(prev.createdAt is timestamp)) && data.createdAt == request.time)
        )
        && (
          // Action: PJ Shift / Kepala Ruang / Admin verifies entry
          (
            'verificationStatus' in prev
            && prev.verificationStatus in ['Pending', 'Revision']
            && data.verificationStatus in ['Approved', 'Revision']
            && 'verifiedBy' in data
            && data.verifiedBy == request.auth.uid
            && 'verifiedAt' in data
            && data.verifiedAt == request.time
            && data.diff(prev).affectedKeys().hasOnly([
              'verificationStatus', 'verifiedBy', 'verifiedByName', 'verificationNote', 'verifiedAt', 'updatedAt'
            ])
            && isValidLogbookVerification(data)
            && isVerifier()
          )
          ||
          // Action: Nurse edits own Draft/Revision entry (locked once Pending or Approved)
          (
            'nurseId' in prev
            && prev.nurseId == request.auth.uid
            && (
              (prev.verificationStatus == 'Draft' && data.verificationStatus in ['Draft', 'Pending']) ||
              (prev.verificationStatus == 'Revision' && data.verificationStatus in ['Revision', 'Pending'])
            )
            && data.diff(prev).affectedKeys().hasOnly([
              'nurseName', 'nurseNip', 'patientId', 'patientName', 'patientRm', 'machineId', 'machineNumber',
              'doctorId', 'doctorName', 'dutyDoctorId', 'dutyDoctorName', 'actionCategory', 'date', 'monthKey', 'shift',
              'startTime', 'endTime', 'preWeight', 'postWeight', 'preBp', 'postBp',
              'ufGoal', 'ufAchieved', 'vascularAccess', 'heparinType', 'complications',
              'nursingNotes', 'verificationStatus', 'targetVerifierRole', 'targetVerifierId', 'targetVerifierName',
              'wizardDetails', 'createdAt', 'updatedAt'
            ])
            && isValidLogbookEntryFields(data)
            && isActiveStaff()
          )
          ||
          // Action: PJ Shift / Kepala Ruang edits submitted Pending/Revision entry before verification
          (
            prev.verificationStatus in ['Pending', 'Revision']
            && data.verificationStatus in ['Pending', 'Revision']
            && data.diff(prev).affectedKeys().hasOnly([
              'nurseName', 'nurseNip', 'patientId', 'patientName', 'patientRm', 'machineId', 'machineNumber',
              'doctorId', 'doctorName', 'dutyDoctorId', 'dutyDoctorName', 'actionCategory', 'date', 'monthKey', 'shift',
              'startTime', 'endTime', 'preWeight', 'postWeight', 'preBp', 'postBp',
              'ufGoal', 'ufAchieved', 'vascularAccess', 'heparinType', 'complications',
              'nursingNotes', 'verificationStatus', 'targetVerifierRole', 'targetVerifierId', 'targetVerifierName',
              'wizardDetails', 'createdAt', 'updatedAt'
            ])
            && isValidLogbookEntryFields(data)
            && isVerifier()
          )
          ||
          // Action: Admin full edit override
          (
            data.diff(prev).affectedKeys().hasOnly([
              'nurseName', 'nurseNip', 'patientId', 'patientName', 'patientRm', 'machineId', 'machineNumber',
              'doctorId', 'doctorName', 'dutyDoctorId', 'dutyDoctorName', 'actionCategory', 'date', 'monthKey', 'shift',
              'startTime', 'endTime', 'preWeight', 'postWeight', 'preBp', 'postBp',
              'ufGoal', 'ufAchieved', 'vascularAccess', 'heparinType', 'complications',
              'nursingNotes', 'verificationStatus', 'targetVerifierRole', 'targetVerifierId', 'targetVerifierName',
              'verifiedBy', 'verifiedByName', 'verificationNote', 'verifiedAt', 'wizardDetails', 'createdAt', 'updatedAt'
            ])
            && isValidLogbookEntryFields(data)
            && isAdmin()
          )
        );
    }

    function isValidPatient(data) {
      return data.keys().hasAll(['mrn', 'fullName', 'gender', 'birthYear', 'vascularAccess', 'diagnosis', 'dpjpId', 'dpjpName', 'routineSchedule', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['mrn', 'fullName', 'gender', 'birthYear', 'vascularAccess', 'diagnosis', 'dpjpId', 'dpjpName', 'routineSchedule', 'status', 'notes', 'createdAt', 'updatedAt'])
        && data.mrn is string && data.mrn.size() >= 2 && data.mrn.size() <= 40
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.gender in ['L', 'P']
        && data.birthYear is number && data.birthYear >= 1900 && data.birthYear <= 2030
        && data.vascularAccess in ['AV Shunt', 'CDL', 'Femoral', 'AVG']
        && data.diagnosis is string && data.diagnosis.size() <= 200
        && data.dpjpId is string && data.dpjpId.size() <= 128
        && data.dpjpName is string && data.dpjpName.size() <= 120
        && data.routineSchedule is string && data.routineSchedule.size() <= 80
        && data.status in ['Aktif', 'Rujuk', 'Meninggal', 'Nonaktif']
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDoctor(data) {
      return data.keys().hasAll(['fullName', 'sipNumber', 'specialization', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['fullName', 'sipNumber', 'specialization', 'phone', 'status', 'createdAt', 'updatedAt'])
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.sipNumber is string && data.sipNumber.size() >= 2 && data.sipNumber.size() <= 60
        && data.specialization is string && data.specialization.size() >= 2 && data.specialization.size() <= 80
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && data.status in ['Aktif', 'Cuti', 'Nonaktif']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMachine(data) {
      return data.keys().hasAll(['machineNumber', 'brand', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['machineNumber', 'brand', 'serialNumber', 'roomZone', 'status', 'lastMaintenanceDate', 'notes', 'createdAt', 'updatedAt'])
        && data.machineNumber is string && data.machineNumber.size() >= 1 && data.machineNumber.size() <= 40
        && data.brand is string && data.brand.size() >= 2 && data.brand.size() <= 80
        && (!('serialNumber' in data) || (data.serialNumber is string && data.serialNumber.size() <= 80))
        && (!('roomZone' in data) || (data.roomZone is string && data.roomZone.size() <= 60))
        && data.status in ['Ready', 'In Use', 'Maintenance', 'Sterilisasi']
        && (!('lastMaintenanceDate' in data) || (data.lastMaintenanceDate is string && data.lastMaintenanceDate.size() <= 20))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSchedule(data) {
      return data.keys().hasAll(['nurseId', 'nurseName', 'date', 'monthKey', 'shift', 'validationStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['nurseId', 'nurseName', 'date', 'monthKey', 'shift', 'validationStatus', 'validatedBy', 'validatedByName', 'notes', 'createdAt', 'updatedAt'])
        && data.nurseId is string && data.nurseId.size() > 0 && data.nurseId.size() <= 128
        && data.nurseName is string && data.nurseName.size() >= 2 && data.nurseName.size() <= 120
        && data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^\\d{4}-\\d{2}$')
        && data.shift in ['Pagi', 'Siang', 'Malam', 'Libur', 'Cuti']
        && data.validationStatus in ['Draft', 'Validated']
        && (!('validatedBy' in data) || (data.validatedBy is string && data.validatedBy.size() <= 128))
        && (!('validatedByName' in data) || (data.validatedByName is string && data.validatedByName.size() <= 120))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDoctorSchedule(data) {
      return data.keys().hasAll(['date', 'monthKey', 'shift', 'dpjpDoctorId', 'dpjpDoctorName', 'dutyDoctorId', 'dutyDoctorName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['date', 'monthKey', 'shift', 'dpjpDoctorId', 'dpjpDoctorName', 'dutyDoctorId', 'dutyDoctorName', 'notes', 'createdAt', 'updatedAt'])
        && data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^\\d{4}-\\d{2}$')
        && data.shift in ['Pagi', 'Siang', 'Malam']
        && data.dpjpDoctorId is string && data.dpjpDoctorId.size() > 0 && data.dpjpDoctorId.size() <= 128
        && data.dpjpDoctorName is string && data.dpjpDoctorName.size() >= 2 && data.dpjpDoctorName.size() <= 120
        && data.dutyDoctorId is string && data.dutyDoctorId.size() > 0 && data.dutyDoctorId.size() <= 128
        && data.dutyDoctorName is string && data.dutyDoctorName.size() >= 2 && data.dutyDoctorName.size() <= 120
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPjShiftAssignment(data) {
      return data.keys().hasAll(['date', 'monthKey', 'shift', 'pjNurseId', 'pjNurseName', 'pjNurseRole', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['date', 'monthKey', 'shift', 'pjNurseId', 'pjNurseName', 'pjNurseRole', 'notes', 'assignedBy', 'assignedByName', 'createdAt', 'updatedAt'])
        && data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^\\d{4}-\\d{2}$')
        && data.shift in ['Pagi', 'Siang', 'Malam']
        && data.pjNurseId is string && data.pjNurseId.size() > 0 && data.pjNurseId.size() <= 128
        && data.pjNurseName is string && data.pjNurseName.size() >= 2 && data.pjNurseName.size() <= 120
        && data.pjNurseRole == 'PJ Shift'
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300))
        && (!('assignedBy' in data) || (data.assignedBy is string && data.assignedBy.size() <= 128))
        && (!('assignedByName' in data) || (data.assignedByName is string && data.assignedByName.size() <= 120))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReportCore(data) {
      return data.keys().hasAll(['reportType', 'date', 'monthKey', 'authorId', 'authorName', 'authorRole', 'createdAt', 'updatedAt'])
        && data.reportType in ['pj_shift', 'patient_care', 'monthly_unit']
        && data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^\\d{4}-\\d{2}$')
        && data.authorId is string && data.authorId.size() > 0 && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 120
        && data.authorRole is string && data.authorRole.size() >= 2 && data.authorRole.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPjShiftBodyFields(data) {
      return (!('shift' in data) || data.shift in ['Pagi', 'Siang', 'Malam'])
        && (!('totalPatients' in data) || (data.totalPatients is number && data.totalPatients >= 0 && data.totalPatients <= 500))
        && (!('activeMachines' in data) || (data.activeMachines is number && data.activeMachines >= 0 && data.activeMachines <= 200))
        && (!('nursesOnDuty' in data) || (data.nursesOnDuty is string && data.nursesOnDuty.size() <= 500))
        && (!('incidents' in data) || (data.incidents is string && data.incidents.size() <= 1000))
        && (!('handoverNotes' in data) || (data.handoverNotes is string && data.handoverNotes.size() <= 2500))
        && (!('sectionDItems' in data) || (data.sectionDItems is list && data.sectionDItems.size() <= 20))
        && (!('sbarSituation' in data) || (data.sbarSituation is string && data.sbarSituation.size() <= 2000))
        && (!('sbarBackground' in data) || (data.sbarBackground is string && data.sbarBackground.size() <= 3000))
        && (!('sbarAssessment' in data) || (data.sbarAssessment is string && data.sbarAssessment.size() <= 2000))
        && (!('sbarRecommendation' in data) || (data.sbarRecommendation is string && data.sbarRecommendation.size() <= 2000));
    }

    function isValidPjShiftReport(data) {
      return isValidReportCore(data)
        && data.keys().hasOnly([
          'reportType', 'date', 'monthKey', 'authorId', 'authorName', 'authorRole',
          'shift', 'totalPatients', 'activeMachines', 'nursesOnDuty', 'incidents', 'handoverNotes',
          'sectionDItems', 'sbarSituation', 'sbarBackground', 'sbarAssessment', 'sbarRecommendation',
          'handoverSignedBy', 'handoverSignedByName', 'handoverSignedShift', 'handoverSignedAt',
          'receivedSignedBy', 'receivedSignedByName', 'receivedSignedShift', 'receivedSignedDate', 'receivedSignedAt',
          'reviewStatus', 'reviewedBy', 'reviewedByName', 'reviewNote', 'reviewedAt',
          'createdAt', 'updatedAt'
        ])
        && isValidPjShiftBodyFields(data);
    }

    function isValidPatientCareReport(data) {
      return isValidReportCore(data)
        && data.keys().hasOnly([
          'reportType', 'date', 'monthKey', 'authorId', 'authorName', 'authorRole',
          'patientId', 'patientName', 'patientRm', 'soapSubjective', 'soapObjective', 'soapAssessment', 'soapPlan', 'medicalOrder',
          'createdAt', 'updatedAt'
        ])
        && (!('patientId' in data) || (data.patientId is string && data.patientId.size() <= 128))
        && (!('patientName' in data) || (data.patientName is string && data.patientName.size() <= 120))
        && (!('patientRm' in data) || (data.patientRm is string && data.patientRm.size() <= 40))
        && (!('soapSubjective' in data) || (data.soapSubjective is string && data.soapSubjective.size() <= 800))
        && (!('soapObjective' in data) || (data.soapObjective is string && data.soapObjective.size() <= 800))
        && (!('soapAssessment' in data) || (data.soapAssessment is string && data.soapAssessment.size() <= 800))
        && (!('soapPlan' in data) || (data.soapPlan is string && data.soapPlan.size() <= 800))
        && (!('medicalOrder' in data) || (data.medicalOrder is string && data.medicalOrder.size() <= 800));
    }

    function isValidMonthlyUnitReport(data) {
      return isValidReportCore(data)
        && data.keys().hasOnly([
          'reportType', 'date', 'monthKey', 'authorId', 'authorName', 'authorRole',
          'targetNurseId', 'targetNurseName', 'targetNurseNip', 'targetNurseRole',
          'nurseSignedBy', 'nurseSignedByName', 'nurseSignedRole', 'nurseSignedAt',
          'karuSignedBy', 'karuSignedByName', 'karuSignedAt',
          'totalTreatments', 'approvedTreatments', 'summaryNotes', 'status',
          'createdAt', 'updatedAt'
        ])
        && (!('targetNurseId' in data) || (data.targetNurseId is string && data.targetNurseId.size() > 0 && data.targetNurseId.size() <= 128))
        && (!('targetNurseName' in data) || (data.targetNurseName is string && data.targetNurseName.size() >= 1 && data.targetNurseName.size() <= 120))
        && (!('targetNurseNip' in data) || (data.targetNurseNip is string && data.targetNurseNip.size() <= 40))
        && (!('targetNurseRole' in data) || (data.targetNurseRole is string && data.targetNurseRole.size() <= 40))
        && (!('nurseSignedBy' in data) || (data.nurseSignedBy is string && data.nurseSignedBy.size() > 0 && data.nurseSignedBy.size() <= 128))
        && (!('nurseSignedByName' in data) || (data.nurseSignedByName is string && data.nurseSignedByName.size() >= 2 && data.nurseSignedByName.size() <= 120))
        && (!('nurseSignedRole' in data) || (data.nurseSignedRole is string && data.nurseSignedRole.size() <= 40))
        && (!('nurseSignedAt' in data) || data.nurseSignedAt is timestamp)
        && (!('karuSignedBy' in data) || (data.karuSignedBy is string && data.karuSignedBy.size() > 0 && data.karuSignedBy.size() <= 128))
        && (!('karuSignedByName' in data) || (data.karuSignedByName is string && data.karuSignedByName.size() >= 2 && data.karuSignedByName.size() <= 120))
        && (!('karuSignedAt' in data) || data.karuSignedAt is timestamp)
        && (!('totalTreatments' in data) || (data.totalTreatments is number && data.totalTreatments >= 0))
        && (!('approvedTreatments' in data) || (data.approvedTreatments is number && data.approvedTreatments >= 0))
        && (!('summaryNotes' in data) || (data.summaryNotes is string && data.summaryNotes.size() <= 1000))
        && (!('status' in data) || data.status in ['Draft', 'Final']);
    }

    function isValidPjShiftContentDelta(data, changed) {
      return changed.hasOnly([
          'shift', 'totalPatients', 'activeMachines', 'nursesOnDuty', 'incidents', 'handoverNotes',
          'sectionDItems', 'sbarSituation', 'sbarBackground', 'sbarAssessment', 'sbarRecommendation', 'updatedAt'
        ])
        && (!changed.hasAny(['shift']) || data.shift in ['Pagi', 'Siang', 'Malam'])
        && (!changed.hasAny(['totalPatients']) || (data.totalPatients is number && data.totalPatients >= 0 && data.totalPatients <= 500))
        && (!changed.hasAny(['activeMachines']) || (data.activeMachines is number && data.activeMachines >= 0 && data.activeMachines <= 200))
        && (!changed.hasAny(['nursesOnDuty']) || (data.nursesOnDuty is string && data.nursesOnDuty.size() <= 500))
        && (!changed.hasAny(['incidents']) || (data.incidents is string && data.incidents.size() <= 1000))
        && (!changed.hasAny(['handoverNotes']) || (data.handoverNotes is string && data.handoverNotes.size() <= 2500))
        && (!changed.hasAny(['sectionDItems']) || (data.sectionDItems is list && data.sectionDItems.size() <= 20))
        && (!changed.hasAny(['sbarSituation']) || (data.sbarSituation is string && data.sbarSituation.size() <= 2000))
        && (!changed.hasAny(['sbarBackground']) || (data.sbarBackground is string && data.sbarBackground.size() <= 3000))
        && (!changed.hasAny(['sbarAssessment']) || (data.sbarAssessment is string && data.sbarAssessment.size() <= 2000))
        && (!changed.hasAny(['sbarRecommendation']) || (data.sbarRecommendation is string && data.sbarRecommendation.size() <= 2000));
    }

    function isValidOtherReportContentDelta(data, changed) {
      return changed.hasOnly([
          'soapSubjective', 'soapObjective', 'soapAssessment', 'soapPlan', 'medicalOrder',
          'totalTreatments', 'approvedTreatments', 'summaryNotes', 'status', 'updatedAt'
        ])
        && (!changed.hasAny(['soapSubjective']) || (data.soapSubjective is string && data.soapSubjective.size() <= 800))
        && (!changed.hasAny(['soapObjective']) || (data.soapObjective is string && data.soapObjective.size() <= 800))
        && (!changed.hasAny(['soapAssessment']) || (data.soapAssessment is string && data.soapAssessment.size() <= 800))
        && (!changed.hasAny(['soapPlan']) || (data.soapPlan is string && data.soapPlan.size() <= 800))
        && (!changed.hasAny(['medicalOrder']) || (data.medicalOrder is string && data.medicalOrder.size() <= 800))
        && (!changed.hasAny(['totalTreatments']) || (data.totalTreatments is number && data.totalTreatments >= 0))
        && (!changed.hasAny(['approvedTreatments']) || (data.approvedTreatments is number && data.approvedTreatments >= 0))
        && (!changed.hasAny(['summaryNotes']) || (data.summaryNotes is string && data.summaryNotes.size() <= 1000))
        && (!changed.hasAny(['status']) || data.status in ['Draft', 'Final']);
    }

    function isValidReport(data) {
      return (data.reportType == 'pj_shift' && isValidPjShiftReport(data))
        || (data.reportType == 'patient_care' && isValidPatientCareReport(data))
        || (data.reportType == 'monthly_unit' && isValidMonthlyUnitReport(data));
    }

    function isValidActionCategory(data) {
      return data.keys().hasAll(['name', 'code', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'code', 'description', 'isActive', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.code is string && data.code.size() >= 2 && data.code.size() <= 20
        && (!('description' in data) || (data.description is string && data.description.size() <= 300))
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLogbookLock(data) {
      return data.keys().hasAll(['id', 'date', 'monthKey', 'patientId', 'patientName', 'nurseId', 'nurseName', 'logbookId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'date', 'monthKey', 'patientId', 'patientName', 'nurseId', 'nurseName', 'logbookId', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 160
        && data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^\\d{4}-\\d{2}$')
        && data.patientId is string && data.patientId.size() > 0 && data.patientId.size() <= 128
        && data.patientName is string && data.patientName.size() >= 1 && data.patientName.size() <= 120
        && data.nurseId is string && data.nurseId.size() > 0 && data.nurseId.size() <= 128
        && data.nurseName is string && data.nurseName.size() >= 1 && data.nurseName.size() <= 120
        && data.logbookId is string && data.logbookId.size() > 0 && data.logbookId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMachineLock(data) {
      return data.keys().hasAll([
          'id', 'date', 'monthKey', 'shift', 'machineId', 'machineNumber',
          'patientId', 'patientName', 'nurseId', 'nurseName', 'logbookId',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'date', 'monthKey', 'shift', 'machineId', 'machineNumber',
          'patientId', 'patientName', 'nurseId', 'nurseName', 'logbookId',
          'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 160
        && data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^\\d{4}-\\d{2}$')
        && data.shift in ['Pagi', 'Siang', 'Malam']
        && data.machineId is string && data.machineId.size() > 0 && data.machineId.size() <= 128
        && data.machineNumber is string && data.machineNumber.size() >= 1 && data.machineNumber.size() <= 40
        && data.patientId is string && data.patientId.size() > 0 && data.patientId.size() <= 128
        && data.patientName is string && data.patientName.size() >= 1 && data.patientName.size() <= 120
        && data.nurseId is string && data.nurseId.size() > 0 && data.nurseId.size() <= 128
        && data.nurseName is string && data.nurseName.size() >= 1 && data.nurseName.size() <= 120
        && data.logbookId is string && data.logbookId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFormTemplate(data) {
      return data.keys().hasAll(['id', 'formTitle', 'monthlyReportTitle', 'sections', 'points', 'updatedAt'])
        && data.keys().hasOnly(['id', 'formTitle', 'monthlyReportTitle', 'sections', 'points', 'sectionCustomFields', 'updatedBy', 'updatedByName', 'updatedAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 64
        && data.formTitle is string && data.formTitle.size() >= 2 && data.formTitle.size() <= 160
        && data.monthlyReportTitle is string && data.monthlyReportTitle.size() >= 2 && data.monthlyReportTitle.size() <= 240
        && data.sections is list && data.sections.size() >= 1 && data.sections.size() <= 12 && data.sections[0] is map
        && data.points is list && data.points.size() >= 1 && data.points.size() <= 120 && data.points[0] is map
        && (!('sectionCustomFields' in data) || (data.sectionCustomFields is map && data.sectionCustomFields.size() <= 12))
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128))
        && (!('updatedByName' in data) || (data.updatedByName is string && data.updatedByName.size() <= 120))
        && data.updatedAt is timestamp;
    }

    // 4. Collection Rules

    // Users (Private PII & RBAC source of truth)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (request.auth.uid == userId && incoming().role == 'Perawat Pelaksana' && incoming().isActive == true)
        );
      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'nip', 'phone', 'specialization', 'role', 'isActive', 'updatedAt']))
          || (
            request.auth.uid == userId
            && incoming().email == existing().email
            && incoming().role == existing().role
            && incoming().isActive == existing().isActive
            && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'nip', 'phone', 'specialization', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Staff Directory (Non-PII display directory for schedules and clinical team)
    match /staff_directory/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isActiveStaff();
      allow list: if isSignedIn() && resource.data.isActive in [true, false] && isActiveStaff();
      allow create: if isSignedIn()
        && isValidId(userId)
        && isValidStaffDirectory(incoming())
        && incoming().uid == userId
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (request.auth.uid == userId && incoming().role == 'Perawat Pelaksana' && incoming().isActive == true)
        );
      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidStaffDirectory(incoming())
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'role', 'isActive', 'updatedAt']))
          || (
            request.auth.uid == userId
            && incoming().role == existing().role
            && incoming().isActive == existing().isActive
            && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Logbook (Hemodialysis clinical action logs)
    match /logbook/{logbookId} {
      allow get: if isSignedIn() && isValidId(logbookId) && isActiveStaff() && (
        resource == null ||
        ('nurseId' in existing() && existing().nurseId == request.auth.uid) ||
        ('verificationStatus' in existing() && existing().verificationStatus in ['Approved', 'Pending', 'Revision', 'Draft']) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.nurseId == request.auth.uid ||
        (resource.data.verificationStatus in ['Approved', 'Pending', 'Revision', 'Draft'] && isActiveStaff()) ||
        (resource.data.verificationStatus in ['Draft', 'Pending', 'Revision'] && isAdmin())
      );
      allow create: if isSignedIn()
        && isValidId(logbookId)
        && isValidLogbookEntry(incoming())
        && incoming().nurseId == request.auth.uid
        && incoming().verificationStatus in ['Draft', 'Pending']
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isActiveStaff();
      allow update: if isSignedIn() && canUpdateLogbook(logbookId, request.resource.data, resource.data);
      allow delete: if isValidId(logbookId) && (
        isAdmin() ||
        (isActiveStaff() && 'nurseId' in existing() && existing().nurseId == request.auth.uid && 'verificationStatus' in existing() && existing().verificationStatus == 'Draft')
      );
    }

    // Patients
    match /patients/{patientId} {
      allow get: if isSignedIn() && isValidId(patientId) && isActiveStaff();
      allow list: if isSignedIn() && resource.data.status in ['Aktif', 'Rujuk', 'Meninggal', 'Nonaktif'] && isActiveStaff();
      allow create: if (isAdmin() || isActiveWithRoles(['Kepala Ruang', 'PJ Shift', 'Perawat Pelaksana']))
        && isValidId(patientId)
        && isValidPatient(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(patientId)
        && isValidPatient(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'mrn', 'fullName', 'gender', 'birthYear', 'vascularAccess', 'diagnosis',
          'dpjpId', 'dpjpName', 'routineSchedule', 'status', 'notes', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(patientId);
    }

    // Doctors
    match /doctors/{doctorId} {
      allow get: if isSignedIn() && isValidId(doctorId) && isActiveStaff();
      allow list: if isSignedIn() && resource.data.status in ['Aktif', 'Cuti', 'Nonaktif'] && isActiveStaff();
      allow create: if isAdmin()
        && isValidId(doctorId)
        && isValidDoctor(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(doctorId)
        && isValidDoctor(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'fullName', 'sipNumber', 'specialization', 'phone', 'status', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(doctorId);
    }

    // Machines
    match /machines/{machineId} {
      allow get: if isSignedIn() && isValidId(machineId) && isActiveStaff();
      allow list: if isSignedIn() && resource.data.status in ['Ready', 'In Use', 'Maintenance', 'Sterilisasi'] && isActiveStaff();
      allow create: if isAdmin()
        && isValidId(machineId)
        && isValidMachine(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(machineId)
        && isValidMachine(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'machineNumber', 'brand', 'serialNumber', 'roomZone', 'status', 'lastMaintenanceDate', 'notes', 'updatedAt'
          ]))
          ||
          (isVerifier() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidId(machineId);
    }

    // Schedules
    match /schedules/{scheduleId} {
      allow get: if isSignedIn() && isValidId(scheduleId) && isActiveStaff() && (
        ('nurseId' in existing() && existing().nurseId == request.auth.uid) || isLeadershipOrAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.nurseId == request.auth.uid ||
        (resource.data.shift in ['Pagi', 'Siang', 'Malam', 'Libur', 'Cuti'] && isLeadershipOrAdmin())
      );
      allow create: if isAdmin()
        && isValidId(scheduleId)
        && isValidSchedule(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(scheduleId)
        && isValidSchedule(incoming())
        && incoming().nurseId == existing().nurseId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'nurseName', 'date', 'monthKey', 'shift', 'validationStatus', 'validatedBy', 'validatedByName', 'notes', 'updatedAt'
          ]))
          ||
          (
            isActiveWithRoles(['Kepala Ruang'])
            && incoming().validationStatus == 'Validated'
            && incoming().validatedBy == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['validationStatus', 'validatedBy', 'validatedByName', 'notes', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(scheduleId);
    }

    // Doctor Schedules (Administrator-managed DPJP & Duty Doctor matrix per date and shift)
    match /doctor_schedules/{scheduleId} {
      allow get: if isSignedIn() && isValidId(scheduleId) && isActiveStaff();
      allow list: if isSignedIn() && resource.data.shift in ['Pagi', 'Siang', 'Malam'] && isActiveStaff();
      allow create: if isAdmin()
        && isValidId(scheduleId)
        && isValidDoctorSchedule(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(scheduleId)
        && isValidDoctorSchedule(incoming())
        && incoming().date == existing().date
        && incoming().shift == existing().shift
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'dpjpDoctorId', 'dpjpDoctorName', 'dutyDoctorId', 'dutyDoctorName', 'notes', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(scheduleId);
    }

    // PJ Shift Assignments (1 designated PJ Shift per date and shift, managed by Admin or Kepala Ruang)
    match /pj_shift_assignments/{assignmentId} {
      allow get: if isSignedIn() && isValidId(assignmentId) && isActiveStaff();
      allow list: if isSignedIn() && resource.data.shift in ['Pagi', 'Siang', 'Malam'] && isActiveStaff();
      allow create: if isSignedIn()
        && isValidId(assignmentId)
        && isValidPjShiftAssignment(incoming())
        && assignmentId == incoming().date + '_' + incoming().shift
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/staff_directory/$(incoming().pjNurseId))
        && (isAdmin() || isKepalaRuangUser());
      allow update: if isSignedIn()
        && isValidId(assignmentId)
        && isValidPjShiftAssignment(incoming())
        && incoming().date == existing().date
        && incoming().shift == existing().shift
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'pjNurseId', 'pjNurseName', 'pjNurseRole', 'notes', 'assignedBy', 'assignedByName', 'updatedAt'
        ])
        && exists(/databases/$(database)/documents/staff_directory/$(incoming().pjNurseId))
        && (isAdmin() || isKepalaRuangUser());
      allow delete: if isValidId(assignmentId) && (isAdmin() || isKepalaRuangUser());
    }

    // Reports (Patient care SOAP, PJ Shift reports, Monthly unit reports)
    match /reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && isActiveStaff() && (
        ('authorId' in existing() && existing().authorId == request.auth.uid) ||
        ('reportType' in existing() && existing().reportType == 'patient_care') ||
        ('reportType' in existing() && existing().reportType == 'monthly_unit' && 'targetNurseId' in existing() && existing().targetNurseId == request.auth.uid) ||
        isLeadershipOrAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        resource.data.reportType == 'patient_care' ||
        (resource.data.reportType == 'monthly_unit' && resource.data.targetNurseId == request.auth.uid) ||
        (resource.data.reportType in ['pj_shift', 'monthly_unit'] && isLeadershipOrAdmin())
      );
      allow create: if isSignedIn()
        && isValidId(reportId)
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (
            incoming().reportType == 'patient_care'
            && isValidPatientCareReport(incoming())
            && isActiveStaff()
          ) ||
          (
            incoming().reportType == 'pj_shift'
            && 'shift' in incoming()
            && isValidPjShiftReport(incoming())
            && (
              !('handoverSignedBy' in incoming())
                ? (!('handoverSignedByName' in incoming()) && !('handoverSignedShift' in incoming()) && !('handoverSignedAt' in incoming()))
                : (
                  incoming().handoverSignedBy == request.auth.uid
                  && 'handoverSignedByName' in incoming() && incoming().handoverSignedByName is string && incoming().handoverSignedByName.size() >= 2 && incoming().handoverSignedByName.size() <= 120
                  && 'handoverSignedShift' in incoming() && incoming().handoverSignedShift == incoming().shift
                  && 'handoverSignedAt' in incoming() && incoming().handoverSignedAt == request.time
                  && isPjShiftUser()
                  && hasAuthorizedPjOnSlot(request.auth.uid, incoming().date, incoming().shift)
                )
            )
            && (
              !('receivedSignedBy' in incoming())
                ? (!('receivedSignedByName' in incoming()) && !('receivedSignedShift' in incoming()) && !('receivedSignedDate' in incoming()) && !('receivedSignedAt' in incoming()))
                : (
                  incoming().receivedSignedBy == request.auth.uid
                  && 'receivedSignedByName' in incoming() && incoming().receivedSignedByName is string && incoming().receivedSignedByName.size() >= 2 && incoming().receivedSignedByName.size() <= 120
                  && 'receivedSignedShift' in incoming() && 'receivedSignedDate' in incoming()
                  && incoming().receivedSignedDate is string && incoming().receivedSignedDate.size() == 10 && incoming().receivedSignedDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
                  && 'receivedSignedAt' in incoming() && incoming().receivedSignedAt == request.time
                  && isNextShiftHandoverMatch(incoming().shift, incoming().date, incoming().receivedSignedShift, incoming().receivedSignedDate)
                  && isPjShiftUser()
                  && hasAuthorizedPjOnSlot(request.auth.uid, incoming().receivedSignedDate, incoming().receivedSignedShift)
                )
            )
            && (
              (!('reviewStatus' in incoming()) || incoming().reviewStatus == 'Submitted')
                ? (!('reviewedBy' in incoming()) && !('reviewedByName' in incoming()) && !('reviewNote' in incoming()) && !('reviewedAt' in incoming()))
                : (
                  incoming().reviewStatus == 'Reviewed'
                  && 'reviewedBy' in incoming() && incoming().reviewedBy == request.auth.uid
                  && (!('reviewedByName' in incoming()) || (incoming().reviewedByName is string && incoming().reviewedByName.size() <= 120))
                  && (!('reviewNote' in incoming()) || (incoming().reviewNote is string && incoming().reviewNote.size() <= 500))
                  && 'reviewedAt' in incoming() && incoming().reviewedAt == request.time
                  && (isKepalaRuangUser() || isAdmin())
                )
            )
            && isVerifier()
          ) ||
          (
            incoming().reportType == 'monthly_unit'
            && 'targetNurseId' in incoming()
            && isValidMonthlyUnitReport(incoming())
            && (
              !('nurseSignedBy' in incoming())
                ? (!('nurseSignedByName' in incoming()) && !('nurseSignedRole' in incoming()) && !('nurseSignedAt' in incoming()))
                : (
                  incoming().nurseSignedBy == request.auth.uid
                  && incoming().targetNurseId == request.auth.uid
                  && 'nurseSignedByName' in incoming()
                  && 'nurseSignedRole' in incoming()
                  && 'nurseSignedAt' in incoming()
                  && incoming().nurseSignedAt == request.time
                  && isActiveStaff()
                )
            )
            && (
              !('karuSignedBy' in incoming())
                ? (
                  !('karuSignedByName' in incoming())
                  && !('karuSignedAt' in incoming())
                  && (!('status' in incoming()) || incoming().status == 'Draft')
                )
                : (
                  incoming().karuSignedBy == request.auth.uid
                  && 'karuSignedByName' in incoming()
                  && 'karuSignedAt' in incoming()
                  && incoming().karuSignedAt == request.time
                  && (!('status' in incoming()) || incoming().status == 'Final')
                  && isKepalaRuangUser()
                )
            )
            && (
              isKepalaRuangUser() ||
              (incoming().targetNurseId == request.auth.uid && isActiveStaff())
            )
          )
        );
      allow update: if isSignedIn()
        && isValidId(reportId)
        && incoming().authorId == existing().authorId
        && incoming().reportType == existing().reportType
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            existing().reportType == 'pj_shift'
            && incoming().date == existing().date
            && incoming().monthKey == existing().monthKey
            && 'reviewStatus' in incoming()
            && incoming().reviewStatus == 'Reviewed'
            && 'reviewedBy' in incoming()
            && incoming().reviewedBy == request.auth.uid
            && 'reviewedByName' in incoming()
            && incoming().reviewedByName is string && incoming().reviewedByName.size() <= 120
            && (!('reviewNote' in incoming()) || (incoming().reviewNote is string && incoming().reviewNote.size() <= 500))
            && 'reviewedAt' in incoming()
            && incoming().reviewedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'reviewStatus', 'reviewedBy', 'reviewedByName', 'reviewNote', 'reviewedAt', 'updatedAt'
            ])
            && (isKepalaRuangUser() || isAdmin())
          )
          ||
          (
            existing().reportType == 'pj_shift'
            && incoming().date == existing().date
            && incoming().monthKey == existing().monthKey
            && 'shift' in existing()
            && !('handoverSignedBy' in existing())
            && 'handoverSignedBy' in incoming()
            && incoming().handoverSignedBy == request.auth.uid
            && 'handoverSignedByName' in incoming()
            && incoming().handoverSignedByName is string && incoming().handoverSignedByName.size() >= 2 && incoming().handoverSignedByName.size() <= 120
            && 'handoverSignedShift' in incoming()
            && incoming().handoverSignedShift == existing().shift
            && 'handoverSignedAt' in incoming()
            && incoming().handoverSignedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'handoverSignedBy', 'handoverSignedByName', 'handoverSignedShift', 'handoverSignedAt', 'updatedAt'
            ])
            && isPjShiftUser()
            && hasAuthorizedPjOnSlot(request.auth.uid, existing().date, existing().shift)
          )
          ||
          (
            existing().reportType == 'pj_shift'
            && incoming().date == existing().date
            && incoming().monthKey == existing().monthKey
            && 'shift' in existing()
            && !('receivedSignedBy' in existing())
            && 'receivedSignedBy' in incoming()
            && incoming().receivedSignedBy == request.auth.uid
            && 'receivedSignedByName' in incoming()
            && incoming().receivedSignedByName is string && incoming().receivedSignedByName.size() >= 2 && incoming().receivedSignedByName.size() <= 120
            && 'receivedSignedShift' in incoming()
            && 'receivedSignedDate' in incoming()
            && incoming().receivedSignedDate is string && incoming().receivedSignedDate.size() == 10 && incoming().receivedSignedDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
            && 'receivedSignedAt' in incoming()
            && incoming().receivedSignedAt == request.time
            && isNextShiftHandoverMatch(existing().shift, existing().date, incoming().receivedSignedShift, incoming().receivedSignedDate)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'receivedSignedBy', 'receivedSignedByName', 'receivedSignedShift', 'receivedSignedDate', 'receivedSignedAt', 'updatedAt'
            ])
            && isPjShiftUser()
            && hasAuthorizedPjOnSlot(request.auth.uid, incoming().receivedSignedDate, incoming().receivedSignedShift)
          )
          ||
          (
            existing().reportType == 'pj_shift'
            && incoming().date == existing().date
            && incoming().monthKey == existing().monthKey
            && (
              !('reviewStatus' in existing())
              || existing().reviewStatus != 'Reviewed'
              || isVerifier()
            )
            && isValidPjShiftContentDelta(incoming(), incoming().diff(existing()).affectedKeys())
            && (existing().authorId == request.auth.uid || isVerifier())
          )
          ||
          (
            existing().reportType == 'monthly_unit'
            && incoming().date == existing().date
            && incoming().monthKey == existing().monthKey
            && 'targetNurseId' in existing()
            && incoming().targetNurseId == existing().targetNurseId
            && existing().targetNurseId == request.auth.uid
            && !('nurseSignedBy' in existing())
            && 'nurseSignedBy' in incoming()
            && incoming().nurseSignedBy == request.auth.uid
            && 'nurseSignedByName' in incoming()
            && incoming().nurseSignedByName is string && incoming().nurseSignedByName.size() >= 2 && incoming().nurseSignedByName.size() <= 120
            && 'nurseSignedRole' in incoming()
            && incoming().nurseSignedRole is string && incoming().nurseSignedRole.size() >= 2 && incoming().nurseSignedRole.size() <= 40
            && 'nurseSignedAt' in incoming()
            && incoming().nurseSignedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'nurseSignedBy', 'nurseSignedByName', 'nurseSignedRole', 'nurseSignedAt',
              'totalTreatments', 'approvedTreatments', 'updatedAt'
            ])
            && isValidMonthlyUnitReport(incoming())
            && isActiveStaff()
          )
          ||
          (
            existing().reportType == 'monthly_unit'
            && incoming().date == existing().date
            && incoming().monthKey == existing().monthKey
            && (!('targetNurseId' in existing()) || incoming().targetNurseId == existing().targetNurseId)
            && !('karuSignedBy' in existing())
            && 'karuSignedBy' in incoming()
            && incoming().karuSignedBy == request.auth.uid
            && 'karuSignedByName' in incoming()
            && incoming().karuSignedByName is string && incoming().karuSignedByName.size() >= 2 && incoming().karuSignedByName.size() <= 120
            && 'karuSignedAt' in incoming()
            && incoming().karuSignedAt == request.time
            && (!('status' in incoming()) || incoming().status == 'Final')
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'karuSignedBy', 'karuSignedByName', 'karuSignedAt', 'status',
              'totalTreatments', 'approvedTreatments', 'updatedAt'
            ])
            && isValidMonthlyUnitReport(incoming())
            && isKepalaRuangUser()
          )
          ||
          (
            existing().reportType == 'patient_care'
            && existing().authorId == request.auth.uid
            && incoming().date == existing().date
            && incoming().monthKey == existing().monthKey
            && (!('reviewStatus' in existing()) || existing().reviewStatus != 'Reviewed')
            && isValidOtherReportContentDelta(incoming(), incoming().diff(existing()).affectedKeys())
            && isActiveStaff()
          )
          ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'date', 'monthKey', 'shift', 'totalPatients', 'activeMachines', 'nursesOnDuty',
              'incidents', 'handoverNotes', 'sectionDItems', 'sbarSituation', 'sbarBackground', 'sbarAssessment', 'sbarRecommendation',
              'reviewStatus', 'reviewedBy', 'reviewedByName', 'reviewNote', 'reviewedAt',
              'patientId', 'patientName', 'patientRm', 'soapSubjective', 'soapObjective', 'soapAssessment', 'soapPlan', 'medicalOrder',
              'totalTreatments', 'approvedTreatments', 'summaryNotes', 'updatedAt'
            ])
            && isValidReport(incoming())
            && isAdmin()
          )
        );
      allow delete: if isAdmin() && isValidId(reportId);
    }

    // Action Categories
    match /action_categories/{categoryId} {
      allow get: if isSignedIn() && isValidId(categoryId) && isActiveStaff();
      allow list: if isSignedIn() && resource.data.isActive in [true, false] && isActiveStaff();
      allow create: if isAdmin()
        && isValidId(categoryId)
        && isValidActionCategory(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(categoryId)
        && isValidActionCategory(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'code', 'description', 'isActive', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    // Logbook Locks (Prevents selecting/submitting the same patient twice on the same date across accounts)
    match /logbook_locks/{lockId} {
      allow get: if isSignedIn() && isValidLockId(lockId) && isActiveStaff();
      allow list: if isSignedIn() && resource.data.date >= '2000-01-01' && isActiveStaff();
      allow create: if isSignedIn()
        && isValidLockId(lockId)
        && isValidLogbookLock(incoming())
        && incoming().id == lockId
        && lockId == incoming().date + '_' + incoming().patientId
        && (
          incoming().nurseId == request.auth.uid ||
          isVerifierEditingPendingLogbook(incoming().logbookId, incoming().nurseId)
        )
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isActiveStaff();
      allow update: if isSignedIn()
        && isValidLockId(lockId)
        && isValidLogbookLock(incoming())
        && incoming().id == lockId
        && lockId == incoming().date + '_' + incoming().patientId
        && incoming().updatedAt == request.time
        && (
          (
            incoming().nurseId == request.auth.uid
            && 'nurseId' in existing()
            && existing().nurseId == request.auth.uid
            && 'logbookId' in existing()
            && existing().logbookId == incoming().logbookId
            && (!('createdAt' in existing()) || !(existing().createdAt is timestamp) || incoming().createdAt == existing().createdAt)
            && (('createdAt' in existing() && existing().createdAt is timestamp) || incoming().createdAt == request.time)
            && isActiveStaff()
          ) ||
          (
            incoming().nurseId == request.auth.uid
            && 'logbookId' in existing()
            && existing().logbookId is string
            && isValidId(existing().logbookId)
            && !exists(/databases/$(database)/documents/logbook/$(existing().logbookId))
            && incoming().createdAt == request.time
            && isActiveStaff()
          ) ||
          isAdmin() ||
          (
            isVerifierEditingPendingLogbook(incoming().logbookId, incoming().nurseId)
            && (
              (
                'logbookId' in existing()
                && existing().logbookId is string
                && isValidId(existing().logbookId)
                && !exists(/databases/$(database)/documents/logbook/$(existing().logbookId))
                && incoming().createdAt == request.time
              ) ||
              (
                'logbookId' in existing()
                && existing().logbookId == incoming().logbookId
                && (!('createdAt' in existing()) || !(existing().createdAt is timestamp) || incoming().createdAt == existing().createdAt)
                && (('createdAt' in existing() && existing().createdAt is timestamp) || incoming().createdAt == request.time)
              )
            )
          )
        );
      allow delete: if isValidLockId(lockId) && (
        isAdmin() ||
        (isActiveStaff() && (
          ('nurseId' in existing() && existing().nurseId == request.auth.uid) ||
          ('logbookId' in existing() && existing().logbookId is string && isValidId(existing().logbookId) && !exists(/databases/$(database)/documents/logbook/$(existing().logbookId))) ||
          (
            isVerifier()
            && 'logbookId' in existing()
            && existing().logbookId is string
            && isValidId(existing().logbookId)
            && exists(/databases/$(database)/documents/logbook/$(existing().logbookId))
            && 'verificationStatus' in get(/databases/$(database)/documents/logbook/$(existing().logbookId)).data
            && get(/databases/$(database)/documents/logbook/$(existing().logbookId)).data.verificationStatus in ['Pending', 'Revision']
          )
        ))
      );
    }

    // Machine Locks (Prevents selecting/assigning the same HD machine/bed by another staff on the same date + shift)
    match /machine_locks/{lockId} {
      allow get: if isSignedIn() && isValidLockId(lockId) && isActiveStaff();
      allow list: if isSignedIn() && resource.data.date >= '2000-01-01' && isActiveStaff();
      allow create: if isSignedIn()
        && isValidLockId(lockId)
        && isValidMachineLock(incoming())
        && incoming().id == lockId
        && lockId == incoming().date + '_' + incoming().shift + '_' + incoming().machineId
        && (
          incoming().nurseId == request.auth.uid ||
          isVerifierEditingPendingLogbook(incoming().logbookId, incoming().nurseId)
        )
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isActiveStaff()
        && exists(/databases/$(database)/documents/machines/$(incoming().machineId))
        && (
          incoming().logbookId == '' ||
          isValidId(incoming().logbookId)
        );
      allow update: if isSignedIn()
        && isValidLockId(lockId)
        && isValidMachineLock(incoming())
        && incoming().id == lockId
        && lockId == incoming().date + '_' + incoming().shift + '_' + incoming().machineId
        && incoming().updatedAt == request.time
        && (
          ('machineId' in existing() && incoming().machineId == existing().machineId) ||
          exists(/databases/$(database)/documents/machines/$(incoming().machineId))
        )
        && (
          incoming().logbookId == '' ||
          isValidId(incoming().logbookId)
        )
        && (
          (
            incoming().nurseId == request.auth.uid
            && 'nurseId' in existing()
            && existing().nurseId == request.auth.uid
            && (!('createdAt' in existing()) || !(existing().createdAt is timestamp) || incoming().createdAt == existing().createdAt)
            && (('createdAt' in existing() && existing().createdAt is timestamp) || incoming().createdAt == request.time)
            && isActiveStaff()
          ) ||
          (
            incoming().nurseId == request.auth.uid
            && 'logbookId' in existing()
            && existing().logbookId is string
            && isValidId(existing().logbookId)
            && !exists(/databases/$(database)/documents/logbook/$(existing().logbookId))
            && incoming().createdAt == request.time
            && isActiveStaff()
          ) ||
          isAdmin() ||
          (
            isVerifierEditingPendingLogbook(incoming().logbookId, incoming().nurseId)
            && (
              (
                'logbookId' in existing()
                && existing().logbookId is string
                && isValidId(existing().logbookId)
                && !exists(/databases/$(database)/documents/logbook/$(existing().logbookId))
                && incoming().createdAt == request.time
              ) ||
              (
                'nurseId' in existing()
                && existing().nurseId == incoming().nurseId
                && (!('createdAt' in existing()) || !(existing().createdAt is timestamp) || incoming().createdAt == existing().createdAt)
                && (('createdAt' in existing() && existing().createdAt is timestamp) || incoming().createdAt == request.time)
              )
            )
          )
        );
      allow delete: if isValidLockId(lockId) && (
        isAdmin() ||
        (isActiveStaff() && (
          ('nurseId' in existing() && existing().nurseId == request.auth.uid) ||
          ('logbookId' in existing() && existing().logbookId is string && isValidId(existing().logbookId) && !exists(/databases/$(database)/documents/logbook/$(existing().logbookId))) ||
          (
            isVerifier()
            && 'logbookId' in existing()
            && existing().logbookId is string
            && isValidId(existing().logbookId)
            && exists(/databases/$(database)/documents/logbook/$(existing().logbookId))
            && 'verificationStatus' in get(/databases/$(database)/documents/logbook/$(existing().logbookId)).data
            && get(/databases/$(database)/documents/logbook/$(existing().logbookId)).data.verificationStatus in ['Pending', 'Revision']
          )
        ))
      );
    }

    // Form Templates (Dynamic HD Nursing Care Form & Monthly Report Configuration managed by Admin)
    match /form_templates/{templateId} {
      allow get: if isSignedIn() && isValidId(templateId) && isActiveStaff();
      allow list: if isSignedIn() && resource.data.id is string && isActiveStaff();
      allow create: if isAdmin()
        && isValidId(templateId)
        && isValidFormTemplate(incoming())
        && incoming().id == templateId
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(templateId)
        && isValidFormTemplate(incoming())
        && incoming().id == existing().id
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(templateId);
    }

    // Connection Probe (Verifies active deployed ruleset for authenticated active staff)
    match /test/connection {
      allow get: if isSignedIn() && isActiveStaff();
    }
  }
}
